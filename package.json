{
  "name": "utho-cdk",
  "version": "0.1.1",
  "description": "Unified TypeScript client + CLI + browser bundle for Utho Cloud Provider OpenAPI",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": {
        "default": "./dist/index.js",
        "module": "./dist/index.mjs"
      },
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "cloudctl": "dist/cli.cjs"
  },
  "scripts": {
  "build": "tsup && tsc --project tsconfig.json --emitDeclarationOnly --declaration --declarationMap --outDir dist && node scripts/post-build.cjs",
    "dev": "tsup --watch",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "generate": "node ./scripts/generate-api.mjs && node ./scripts/wrap-endpoints.mjs",
    "prepare": "husky install"
  },
  "keywords": [
    "openapi",
    "swagger",
    "client",
    "cli",
    "browser",
    "typescript"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "axios": "^1.7.0",
    "commander": "^12.0.0",
    "inquirer": "^9.2.15",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.14.9",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "openapi-typescript": "^7.0.0",
    "yaml": "^2.5.0",
    "tsup": "^8.0.1",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/utho-cdk.git"
  },
  "homepage": "https://github.com/your-org/utho-cdk#readme",
  "bugs": { "url": "https://github.com/your-org/utho-cdk/issues" },
  "author": "Your Name <you@example.com>",
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "vitest related --run"
    ]
  }
}
